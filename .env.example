# Secrets - NEVER commit the real .env file
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
JWT_ISSUER=visionattend-api
JWT_AUDIENCE=visionattend-client

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Email transport for verification, 2FA OTP, and password reset
# Production on Render should use Brevo's HTTPS API instead of SMTP.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=VisionAttend AI

# Local SMTP fallback (not recommended for Render Free)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com

# Authentication rate limiting
AUTH_IP_LIMIT=10
AUTH_ACCOUNT_LIMIT=5
AUTH_WINDOW_SECONDS=300
AUTH_BACKOFF_BASE_SECONDS=1
AUTH_BACKOFF_MAX_SECONDS=60

# General API limits
PUBLIC_LIMIT=60
PUBLIC_WINDOW_SECONDS=60
AUTHENTICATED_LIMIT=120
AUTHENTICATED_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=8000000

# Face image limits
MAX_FACE_IMAGE_BASE64_CHARS=7000000
MAX_FACE_IMAGE_BYTES=5000000

# Face enrollment uniqueness threshold
FACE_UNIQUENESS_THRESHOLD=0.60

# bcrypt maximum is 72 UTF-8 bytes
MAX_PASSWORD_BYTES=72

# VisionAttend AI Assistant - free Gemini API tier
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
