# Secrets - NEVER commit the real .env file
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=12
JWT_ISSUER=visionattend-api
JWT_AUDIENCE=visionattend-client

# Browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Legal notice versions
TERMS_VERSION=2026-08-31
PRIVACY_VERSION=2026-08-31
COOKIE_VERSION=2026-08-31

# SMTP for email verification and 2FA OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SSL=false
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
MAIL_FROM=your-email@gmail.com

# Authentication rate limiting
AUTH_IP_LIMIT=10
AUTH_ACCOUNT_LIMIT=5
AUTH_WINDOW_SECONDS=300
AUTH_BACKOFF_BASE_SECONDS=1
AUTH_BACKOFF_MAX_SECONDS=60

# General API limits
PUBLIC_LIMIT=60
PUBLIC_WINDOW_SECONDS=60
AUTHENTICATED_LIMIT=120
AUTHENTICATED_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=8000000

# Face image limits
MAX_FACE_IMAGE_BASE64_CHARS=7000000
MAX_FACE_IMAGE_BYTES=5000000

# Face enrollment uniqueness threshold
FACE_UNIQUENESS_THRESHOLD=0.60

# bcrypt maximum is 72 UTF-8 bytes
MAX_PASSWORD_BYTES=72
